generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model author {
  id                       Int      @id @default(autoincrement())
  username                 String   @db.VarChar(255)
  password                 String   @db.VarChar(255)
  name                     String?  @db.VarChar(255)
  surname                  String?  @db.VarChar(255)
  slug                     String   @db.Text
  img                      String?  @db.Text
  active                   Boolean  @default(true)
  createdAt                DateTime @default(now()) @db.DateTime(0)

  news                     news[]   @relation("author_news")
}

model news {
  id                       Int       @id @default(autoincrement())
  title                    String    @db.Text
  content                  String?   @db.Text
  slug                     String    @db.Text
  img                      String?   @db.Text
  author                   Int
  topic                    Int
  active                   Boolean   @default(true)
  createdAt                DateTime  @default(now()) @db.DateTime(0)
  updatedAt                DateTime  @updatedAt @db.DateTime(0)

  author_rs                author    @relation("author_news", fields: [author], references: [id], onDelete: Cascade)
  topic_rs                 topic     @relation("topic_news", fields: [topic], references: [id], onDelete: Cascade)

  @@index([author], map: "author")
  @@index([topic], map: "topic")
}

model topic {
  id                       Int      @id @default(autoincrement())
  name                     String   @db.VarChar(255)
  slug                     String   @db.Text
  img                      String?  @db.Text

  news                     news[]   @relation("topic_news")
}
